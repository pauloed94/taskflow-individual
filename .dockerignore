# Arquivos que NÃO devem ir para dentro da imagem Docker (contexto de build)

# Ambientes virtuais locais
.venv/
venv/

# Controle de versão e CI (não fazem parte da aplicação)
.git/
.github/

# Documentação
docs/

# Cache do Python
__pycache__/
*.pyc

# Segredos locais: nunca copiar para a imagem
.env
.env.*
